# personal creature state — each anima's life is private and machine-local
# (no trailing slash: also ignore a `.anima` SYMLINK, e.g. a git-worktree pointing at the real store)
.anima

# the Caddy binary (48MB Mach-O; downloaded per-machine, not source)
/caddy

# python
__pycache__/
*.py[cod]
.venv/
venv/

# generated audit/observatory artifacts — regenerated by the certs/observatories on demand;
# never source. Tracking them dirties the tree on every run (breaks deploy_check's RUNNING==
# COMMITTED check) and risks a stale committed snapshot lying about the live audit state.
reports/

# Claude Code local session data (not product code)
.claude/
